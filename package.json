{
  "name": "lattice-term",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "A secure, cross-platform workspace for SSH, SFTP, RDP, and remote desktop access.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/NickYCLin/LatticeTerm.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:rdp": "node scripts/build-rdp-engine.mjs",
    "build:rdp:release": "node scripts/build-rdp-engine.mjs --release",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
