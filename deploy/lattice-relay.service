# Lattice Remote relay server — systemd unit.
# Installed by scripts/deploy-relay.sh; adjust the bind address or state path
# here and run `systemctl daemon-reload && systemctl restart lattice-relay`.
# The secure default expects an HTTPS/WebSocket ingress on the same host.
# That ingress makes every public client look like 127.0.0.1, which exempts
# them all from the per-IP connection limit. Append --client-ip-header with
# the header your ingress sets to the real client address (Cf-Connecting-Ip
# behind Cloudflare, X-Real-Ip behind nginx) to charge them properly, but
# only if that proxy overwrites the header rather than trusting the client's.
[Unit]
Description=Lattice Remote relay server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lattice-relay
Group=lattice-relay
ExecStart=/usr/local/bin/lattice-relay --bind 127.0.0.1:44910 --state /var/lib/lattice-relay/devices.json
Restart=always
RestartSec=2
UMask=0077
LimitNOFILE=2048
TasksMax=512
MemoryMax=512M

# The relay needs nothing but a socket and its state file.
StateDirectory=lattice-relay
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
